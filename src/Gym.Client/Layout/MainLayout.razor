@inherits LayoutComponentBase
<div class="shell">
    <header class="shell-header">
        <nav class="navbar navbar-expand-lg navbar-dark shell-navbar rounded-4 px-3 px-lg-4 py-3 shadow-sm">
            <div class="container-fluid p-0">
                <NavLink class="navbar-brand d-flex align-items-center gap-3" href="" Match="NavLinkMatch.All">
                    <span class="brand-mark">G</span>
                    <span>
                        <strong class="d-block">Gym.Client</strong>
                        <small class="text-uppercase brand-subtitle">Member Desk</small>
                    </span>
                </NavLink>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <div class="navbar-nav ms-auto gap-lg-2 mt-3 mt-lg-0">
                        <NavLink class="nav-link px-3 py-2 rounded-pill" href="" Match="NavLinkMatch.All">Overview</NavLink>
                        <NavLink class="nav-link px-3 py-2 rounded-pill" href="members">Members</NavLink>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="shell-main">
        <div class="container-xxl py-4 py-lg-5">
            @Body
        </div>
    </main>
</div>
