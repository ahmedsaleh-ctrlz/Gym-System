@page "/"
@inject MembersApiClient MembersApiClient

<PageTitle>Gym Dashboard</PageTitle>

<section class="hero-card p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="eyebrow">Member operations</span>
            <h1 class="display-5 fw-bold mt-3 mb-3">Run your member desk from one clean workspace.</h1>
            <p class="lead text-secondary-emphasis mb-4">
                Create member accounts, keep profile details current, review recent additions, and manage the member list without leaving the browser.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <NavLink class="btn btn-danger btn-lg rounded-pill px-4" href="members">Open Members Workspace</NavLink>
                <a class="btn btn-outline-light btn-lg rounded-pill px-4" href="http://localhost:5194/api/members" target="_blank">Open API</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="metric-grid">
                <div class="metric-card">
                    <span class="metric-label">Total members</span>
                    <strong class="metric-value">@TotalMembers</strong>
                </div>
                <div class="metric-card">
                    <span class="metric-label">Page size</span>
                    <strong class="metric-value">6</strong>
                </div>
                <div class="metric-card metric-card-wide">
                    <span class="metric-label">Latest member</span>
                    <strong class="metric-value metric-text">@(LatestMemberName ?? "No members yet")</strong>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="row g-4">
    <div class="col-lg-7">
        <div class="panel-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Recent members</h2>
                    <p class="text-secondary mb-0">A quick look at the latest accounts in the system.</p>
                </div>
                <NavLink class="btn btn-outline-danger rounded-pill px-3" href="members">Manage all</NavLink>
            </div>

            @if (IsLoading)
            {
                <div class="py-4 text-center text-secondary">Loading dashboard data...</div>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger rounded-4 mb-0">@ErrorMessage</div>
            }
            else if (RecentMembers.Count == 0)
            {
                <div class="empty-state">
                    <h3 class="h5 mb-2">No members yet</h3>
                    <p class="text-secondary mb-0">Create the first member from the members workspace.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var member in RecentMembers)
                    {
                        <div class="list-group-item bg-transparent px-0 py-3 border-secondary-subtle">
                            <div class="d-flex align-items-center gap-3">
                                <img class="avatar-thumb" src="@member.ImageUrl" alt="@member.FirstName @member.LastName" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@member.FirstName @member.LastName</div>
                                    <div class="text-secondary small">@member.PhoneNumber</div>
                                </div>
                                <span class="badge text-bg-light rounded-pill">@member.JoinDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel-card h-100">
            <h2 class="h4 mb-3">What’s included</h2>
            <div class="feature-stack">
                <div class="feature-item">
                    <strong>Member API</strong>
                    <span>List, search, create, update, change image, and soft-delete members.</span>
                </div>
                <div class="feature-item">
                    <strong>Bootstrap workspace</strong>
                    <span>Responsive cards, forms, badges, and tables that work well on desktop and tablet.</span>
                </div>
                <div class="feature-item">
                    <strong>Identity-backed creation</strong>
                    <span>Creating a member also provisions their linked account using the current application flow.</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool IsLoading = true;
    private string? ErrorMessage;
    private int TotalMembers;
    private string? LatestMemberName;
    private List<MemberItem> RecentMembers = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var response = await MembersApiClient.GetMembersAsync(pageNumber: 1, pageSize: 6);
            TotalMembers = response.TotalCount;
            RecentMembers = response.Items?.ToList() ?? [];
            LatestMemberName = RecentMembers.FirstOrDefault() is { } member
                ? $"{member.FirstName} {member.LastName}"
                : null;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
